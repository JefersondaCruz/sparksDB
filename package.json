{
  "name": "sparksdb",
  "productName": "sparksDB",
  "version": "0.1.0",
  "description": "Cliente Postgres desktop basico - conectar, navegar schemas e rodar SQL",
  "private": true,
  "author": "Jeferson da Cruz",
  "scripts": {
    "dev:vite": "vite dev",
    "build:vite": "vite build",
    "setup": "scripts/setup-dev.sh",
    "dev": "concurrently -k -n vite,app \"vite dev\" \"PYTHONPATH=backend .venv/bin/python -m sparksdb --dev\"",
    "build:appimage": "npm run build:vite && scripts/build-appimage.sh",
    "test:backend": ".venv/bin/python -m pytest backend"
  },
  "dependencies": {
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@lucide/vue": "^1.41.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.5.5",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}
